{
    "name": "@mosaiq/nsm-common",
    "version": "1.0.0",
    "description": "Shared NSM types, API route contracts, and pure utilities. Source-only (no build); consumers resolve it via TS/bundler path aliases to src/.",
    "private": true,
    "type": "module",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*.ts"
    },
    "scripts": {
        "lint": "eslint .",
        "types": "tsc --noemit"
    },
    "dependencies": {},
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@types/node": "^22.10.2",
        "eslint": "^9.21.0",
        "globals": "^16.0.0",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.24.1"
    }
}
